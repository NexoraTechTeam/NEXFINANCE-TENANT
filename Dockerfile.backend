FROM node:18-alpine

WORKDIR /app

RUN apk add --no-cache curl

COPY backend/package*.json ./
RUN npm ci --only=development

COPY backend/ .

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:5000/health || exit 1

CMD ["npm", "run", "dev"]
