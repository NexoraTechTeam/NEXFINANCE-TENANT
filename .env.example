# NexFinance – Local Development Environment
# Copy this file to .env and adjust values as needed
# These variables only affect docker-compose.yml (dev mode)

# ── Host port bindings ──────────────────────────────────────────────────────
# If any of these ports are already in use on your machine, change the
# left-hand number to any free port (e.g. BACKEND_HOST_PORT=5100).
# The right-hand (container-internal) port stays fixed and must NOT be changed.

POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=5000
FRONTEND_HOST_PORT=3000
HTTP_HOST_PORT=80
HTTPS_HOST_PORT=443

# ── Backend secrets ─────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-key-change-in-production
