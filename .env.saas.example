# Written by the deploy workflow into $APP_DIR/.env.saas (never commit real values).
STACK=nexfin-saas
SAAS_TRAEFIK_RULE=Host(`console-nexfinance.nexoratech.co`) || Host(`almusabbihin-nexfinance.nexoratech.co`)
JWT_SECRET=change-me-long-random
DB_PASSWORD=change-me-long-random
CONSOLE_HOSTS=console-nexfinance.nexoratech.co
# Parent domain (<slug>.<base>) or a pattern with {label} (slug without hyphens) / {slug}
TENANT_BASE_DOMAIN={label}-nexfinance.nexoratech.co
CONSOLE_ADMIN_EMAIL=ops@nexoratech.co
CONSOLE_ADMIN_PASSWORD=change-me
# Optional: sales demo tenant with sample data
DEMO_TENANT_HOSTS=
