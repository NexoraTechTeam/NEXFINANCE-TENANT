NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/nexfinance_db
REDIS_URL=redis://localhost:6379
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRY=24h
LOG_LEVEL=debug

# Notification - Email
# Example: internal webhook / SendGrid bridge endpoint
EMAIL_PROVIDER_NAME=generic-webhook
EMAIL_PROVIDER_URL=
EMAIL_WEBHOOK_URL=
EMAIL_PROVIDER_TOKEN=

# Notification - WhatsApp (Meta Cloud API)
WHATSAPP_META_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Optional fallback WhatsApp webhook (if not using Meta API directly)
WHATSAPP_WEBHOOK_URL=
