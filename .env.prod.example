# Production environment variables — copy this to .env on the VPS
# Path: /root/nexora-node/apps/nexfinance/.env
#
# Docker Compose will automatically read .env from the same directory.
# These values override the defaults in docker-compose.prod.yml.

# REQUIRED — Change this to a strong random string (min 32 chars)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-here

# Optional — default is 24h
JWT_EXPIRY=24h
